        "kind": "struct",
        "fields": [
          { "name": "seller", "type": "publicKey" },
          { "name": "title", "type": "string" },
          { "name": "description", "type": "string" },
          { "name": "imageUri", "type": "string" },
          { "name": "startingBid", "type": "u64" },
          { "name": "currentBid", "type": "u64" },
