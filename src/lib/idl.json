        { "name": "auction", "isMut": true, "isSigner": false },
        { "name": "bidder", "isMut": true, "isSigner": true },
        { "name": "bidderTokenAccount", "isMut": true, "isSigner": false },
        { "name": "prevBidderTokenAccount", "isMut": true, "isSigner": false },
        { "name": "escrowTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "amount", "type": "u64" }
      ]
    },
    {
      "name": "endAuction",
      "accounts": [
        { "name": "auction", "isMut": true, "isSigner": false },
        { "name": "escrowTokenAccount", "isMut": true, "isSigner": false },
        { "name": "sellerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
