    },
    {
      "name": "BidPlaced",
      "fields": [
        { "name": "auction", "type": "publicKey", "index": false },
        { "name": "bidder", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false }
      ]
    },
    {
      "name": "AuctionFinished",
      "fields": [
        { "name": "auction", "type": "publicKey", "index": false },
        { "name": "winner", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false }
      ]
    }
  ],

  "errors": [
